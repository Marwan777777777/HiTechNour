{
  "name": "hightechnour-attendance-backend",
  "version": "1.0.0",
  "description": "Backend for HighTechNour attendance app - auth, geofenced check-ins/outs, device binding",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
